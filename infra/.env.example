# infra/.env.example
#
# Copy to `.env` in this directory and fill in real values.
# Never commit a real `.env` file.

# --- postgres ---
POSTGRES_USER=anpr
POSTGRES_PASSWORD=changeme
POSTGRES_DB=anpr
POSTGRES_PORT=5432

# --- redis ---
REDIS_PORT=6379

# --- backend ---
BACKEND_PORT=8000
# Comma-separated allowed origins for CORS
BACKEND_CORS_ORIGINS=http://localhost:3000
JWT_SECRET=changeme
JWT_EXPIRES_IN=24h
# Evidence image retention period in days (see docs/FRD.md NFR-5 — confirm
# with stakeholders before relying on this default)
EVIDENCE_RETENTION_DAYS=90

# --- cv-service ---
# Path to per-gate config file(s) — see docs/ARCHITECTURE.md section 7 and
# docs/CLAUDE_CODE_KICKOFF.md Phase 2 (gate_id, camera_uri,
# inbound_reference_vector, camera_angle_deg)
CV_GATES_CONFIG_PATH=/app/config/gates.yaml
CV_EVIDENCE_STORAGE_PATH=/data/evidence
# Redis Stream name detection events are published to
CV_DETECTION_STREAM=detections

# --- frontend ---
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
